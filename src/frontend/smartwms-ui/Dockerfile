FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN npm install -g pnpm@10.16.1 && pnpm install --frozen-lockfile

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_COGNITO_USER_POOL_ID
ARG VITE_COGNITO_CLIENT_ID
ARG VITE_COGNITO_DOMAIN
ARG VITE_COGNITO_REGION
ARG VITE_REDIRECT_SIGN_IN
ARG VITE_REDIRECT_SIGN_OUT
ARG VITE_COGNITO_REDIRECT_URI
ARG VITE_COGNITO_POST_LOGOUT_REDIRECT_URI

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_COGNITO_USER_POOL_ID=$VITE_COGNITO_USER_POOL_ID
ENV VITE_COGNITO_CLIENT_ID=$VITE_COGNITO_CLIENT_ID
ENV VITE_COGNITO_DOMAIN=$VITE_COGNITO_DOMAIN
ENV VITE_COGNITO_REGION=$VITE_COGNITO_REGION
ENV VITE_REDIRECT_SIGN_IN=$VITE_REDIRECT_SIGN_IN
ENV VITE_REDIRECT_SIGN_OUT=$VITE_REDIRECT_SIGN_OUT
ENV VITE_COGNITO_REDIRECT_URI=$VITE_COGNITO_REDIRECT_URI
ENV VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=$VITE_COGNITO_POST_LOGOUT_REDIRECT_URI

RUN pnpm build

FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:4714e0b1b2577eaa1a6131d07c958b67f0eb68e6d0521e90c6e5287db8cf0bc5 AS runtime
USER root
# CVE-2026-93990: this pinned base still contains libexpat 2.8.4-r0.
RUN apk add --no-cache --upgrade libexpat=2.8.5-r0
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
USER 101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
