{
  "name": "smartwms-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) throw new Error('Use pnpm')\"",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/frontend.xml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "aws-amplify": "^6.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "only-allow": "^1.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
