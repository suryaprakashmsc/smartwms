pipeline {
  agent { label 'smartwms-local' }
  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '3'))
  }
  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm
        script {
          def checkedOutCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          if (!(checkedOutCommit ==~ /[0-9a-f]{40}/)) {
            error('Cannot identify the checked-out Git commit')
          }
          env.GIT_COMMIT = checkedOutCommit
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${checkedOutCommit.take(12)}"
        }
      }
    }
    stage('Tests and dependency audit') {
      steps { sh 'bash pipeline/ci-test.sh' }
      post {
        always {
          junit testResults: 'reports/frontend/*.xml', allowEmptyResults: true
          archiveArtifacts artifacts: 'reports/**/*.trx', allowEmptyArchive: true
        }
      }
    }
    stage('Build and scan release images') {
      steps { sh 'bash pipeline/build-images.sh' }
    }
    stage('Local release bundle') {
      steps {
        archiveArtifacts artifacts: 'release/*', fingerprint: true
        echo "Local release ${env.IMAGE_TAG} verified. Download the release bundle for explicit k3d deployment. AWS publishing is disabled."
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'reports/**/*.json', allowEmptyArchive: true
      sh '''
        if [ -n "${IMAGE_TAG:-}" ]; then
          docker image rm "smartwms-tests:$IMAGE_TAG" "smartwms-ui-tests:$IMAGE_TAG" \
            "smartwms-inventory:$IMAGE_TAG" "smartwms-ui:$IMAGE_TAG" >/dev/null 2>&1 || true
        fi
      '''
    }
  }
}
